# =====================================================================
#  Cluster settings — the ONLY file you must edit before setup.
#  Every script in scripts/ reads this file. Keep it identical on all
#  three machines (it is in git, so just `git pull`).
# =====================================================================

# ---- Machines (use `ip a` on each machine to find its LAN IP) -------
MASTER_HOST=bd-master
MASTER_IP=192.168.1.10

WORKER1_HOST=bd-worker1
WORKER1_IP=192.168.1.11

WORKER2_HOST=bd-worker2
WORKER2_IP=192.168.1.12

# Linux username used on ALL three machines (must be the same name).
CLUSTER_USER=bigdata

# ---- Software versions ---------------------------------------------
JAVA_PKG=openjdk-11-jdk
SPARK_VERSION=3.5.3
HADOOP_VERSION=3.3.6
SPARK_HOME=/opt/spark
HADOOP_HOME=/opt/hadoop
HDFS_DATA_DIR=/opt/hdfs-data
HDFS_REPLICATION=2

# ---- Resources each worker offers to Spark --------------------------
# Rule of thumb: leave 1 core and ~2 GB RAM for the OS.
WORKER_CORES=2
WORKER_MEMORY=3g
EXECUTOR_MEMORY=2g
DRIVER_MEMORY=2g
SHUFFLE_PARTITIONS=16

# ---- Data -----------------------------------------------------------
# GHCN-Daily yearly files are ~150-250 MB gzipped each (~30-40M rows).
# Start with 2 years while testing, then widen the range.
YEAR_START=2014
YEAR_END=2023
HDFS_BASE=/weather
